# ============================================================================
# retro-gaming-html5
# ============================================================================
# Public monorepo of browser games and the spec-driven record that produced
# them. Public artifacts: the specifications under docs/specs/, each game's
# servable game/ tree, the executable tests that prove each spec's validations,
# and the pull requests that implement them. Dependencies, generated output,
# raw asset staging, and licensed reference material stay out of the tree.
# ============================================================================

# ----------------------------------------------------------------------------
# Node / JS dependencies (the toolchain is tracked; installed packages are not)
# ----------------------------------------------------------------------------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package.json, package-lock.json, and playwright.config are TRACKED.

# ----------------------------------------------------------------------------
# Test artifacts (test SOURCE is tracked; generated results are not)
# ----------------------------------------------------------------------------
# Validations live in each spec and are proven by tracked tests with fixed
# seeds and fixtures, so a fresh clone can reproduce them. Only the generated
# output and downloaded browser binaries are ignored.
test-results/
playwright-report/
playwright/.cache/
blob-report/
coverage/
.nyc_output/

# ----------------------------------------------------------------------------
# Licensed reference material (studied as shapes, never redistributed)
# ----------------------------------------------------------------------------
reference/
reference-files-*/

# ----------------------------------------------------------------------------
# Raw asset staging (sourced from the ML01 library; never committed)
# ----------------------------------------------------------------------------
# Wireframe-arc games ship zero assets. Sprite-arc games commit CURATED,
# license-cleared finished-game assets under their own game/assets/ with a
# manifest; the raw purchased packs and working staging stay ignored.
asset-game/

# ----------------------------------------------------------------------------
# Ideation and working material (the public design capture lives in docs/)
# ----------------------------------------------------------------------------
internal-files/
staging/
*-pending.md

# ----------------------------------------------------------------------------
# Retirement holding area (move-not-delete convention; never committed)
# ----------------------------------------------------------------------------
recycle-bin/

# ----------------------------------------------------------------------------
# Secrets and credentials
# ----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
secrets/
credentials/
config.local.*

# ----------------------------------------------------------------------------
# Editor and OS
# ----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------------------------------------------------------
# Misc build and temp
# ----------------------------------------------------------------------------
dist/
*.log
*.tmp
*.bak
tmp/
